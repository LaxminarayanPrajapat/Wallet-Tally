# Test Environment Configuration
# Copy this file to .env.test and update with your test database credentials

# Application Environment
APP_ENV=testing

# MySQL Test Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=wallet_tally_test

# Firebase Configuration
FIREBASE_PROJECT_ID=your-test-project-id
FIREBASE_CREDENTIALS_PATH=/path/to/test-credentials.json
FIREBASE_EMULATOR=true

# Property-Based Testing Configuration
ERIS_ITERATIONS=100

# Firebase Emulator Ports (if using emulator)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
