{
    "name": "wallet-tally/app",
    "description": "Personal finance management application with Firebase backend",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^7.0",
        "google/cloud-firestore": "^1.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "giorgiosironi/eris": "^0.14",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "WalletTally\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WalletTally\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:property": "phpunit --testsuite property",
        "test:integration": "phpunit --testsuite integration",
        "test:coverage": "phpunit --coverage-html coverage --coverage-clover coverage.xml",
        "lint": "phpcs --standard=PSR12 src/ tests/",
        "lint:fix": "phpcbf --standard=PSR12 src/ tests/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}